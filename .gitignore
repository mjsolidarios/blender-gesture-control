*.task
hand_landmarker.task
addon_deps/
.vendor/
vendor/

# Webcam / debug captures (do not commit camera dumps)
captures/
recordings/
frames/
*.mp4
*.avi
*.mkv
*.webm
*.mov

# Blender local scene files and autosaves
*.blend
*.blend1
*.blend2
*.blend@

